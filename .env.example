# =====================================================================
# QRDine Environment Configuration Template
# Copy this file to .env.local and populate with your credentials
# =====================================================================

# 1. Supabase Public API (Required for Frontend & Browser client)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL & Project API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role key
# Warning: Bypasses Row Level Security. Only used in server-side administrative endpoints.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Application Public URL
# Used for absolute URL generation in QR codes and auth redirect callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Super Admin Whitelist (Optional comma-separated list of Super Admin emails)
SUPER_ADMIN_EMAILS=admin@qrdine.com,owner@qrdine.com
